# Defaults use backend/data/atlas.db and persist a generated key in backend/data/.jwt-key.
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://atlas:change-me@localhost:5432/atlas
# DATA_DIR=/app/data
# SECRET_KEY=replace-with-a-long-random-secret
# Enable secure cookies only when served through HTTPS:
COOKIE_SECURE=false
# Vite origin for a separate dev frontend (production same origin needs no value):
FRONTEND_ORIGIN=http://127.0.0.1:5173
